# Path to your DDO installation directory
DDO_PATH=

# Sentry — error reporting (optional)
#
# All variables are optional. The app builds and runs without any of them;
# Sentry just goes silent (no auto-capture, no Replay), and the GitHub-issue
# Report buttons still work without correlation IDs.

# Client-side DSN. Inlined into the production bundle at build time.
# DSNs are designed to be public (write-only ingestion key, rate-limited
# per project), so shipping it in the bundle is safe by design.
VITE_SENTRY_DSN=

# Org and project slugs. Used at build time by @sentry/vite-plugin for
# source-map upload AND at runtime to construct clickable Sentry replay
# URLs in the bottom-bar "Report a bug" issue body. Both slugs are
# public (they're already in your Sentry dashboard URL), so the VITE_
# prefix that inlines them into the bundle is safe.
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=

# CI-only secret: source-map upload auth token. Used by
# @sentry/vite-plugin during `npm run build`. NOT VITE_-prefixed
# because it must stay out of the public client bundle. When unset,
# the plugin no-ops.
SENTRY_AUTH_TOKEN=
