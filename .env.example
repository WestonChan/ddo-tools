# Origin of the ddo-api deployment the frontend reads game data from.
# No trailing slash. Leave unset to use the public API; point it at a
# local `ddo-api` (e.g. http://localhost:8089) while developing the API.
VITE_API_URL=

# Sentry — error reporting (optional)
#
# All variables are optional. The app builds and runs without any of them;
# Sentry just goes silent (no auto-capture, no Replay), and the GitHub-issue
# Report buttons still work without correlation IDs.

# Names match what Vercel's Sentry integration injects, so the integration
# alone configures production. Vite only exposes VITE_-prefixed variables to
# the client, so vite.config.ts inlines SENTRY_DSN and SENTRY_ORG explicitly
# and leaves the rest build-side.
#
# Client-side DSN. Inlined into the production bundle at build time.
# DSNs are designed to be public (write-only ingestion key, rate-limited
# per project), so shipping it in the bundle is safe by design.
SENTRY_DSN=

# Org and project slugs. The org is inlined at build time so the bottom-bar
# "Report a bug" issue body can link to Sentry replays; both are used by
# @sentry/vite-plugin for source-map upload. Both slugs are public (they're
# already in your Sentry dashboard URL).
SENTRY_ORG=
SENTRY_PROJECT=

# Build-only secret: source-map upload auth token. Used by
# @sentry/vite-plugin during `npm run build` and never inlined. When unset,
# the plugin no-ops.
SENTRY_AUTH_TOKEN=
