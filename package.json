{
  "name": "ddo-tools",
  "private": true,
  "version": "0.0.69",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WestonChan/ddo-tools.git"
  },
  "homepage": "https://ddo-tools.com/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && stylelint \"src/**/*.css\" && npm run lint:types && npm run lint:dead-code && npm run lint:ignored && npm run format:check",
    "lint:dead-code": "knip --no-progress",
    "lint:ignored": "! { git ls-files --cached --ignored --exclude-standard; git ls-files --others --ignored --exclude-standard -- src e2e eslint-rules; } | grep -v '/\\.DS_Store$' | grep . || (echo 'The files above match a .gitignore pattern; anchor the pattern to the repo root (for example /build/).' && exit 1)",
    "lint:types": "tsc -p tsconfig.test.json --noEmit",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix && npm run format",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"{src,e2e,eslint-rules}/**/*.{ts,tsx,js,css}\" \"*.{js,mjs,ts}\"",
    "format:check": "prettier --check \"{src,e2e,eslint-rules}/**/*.{ts,tsx,js,css}\" \"*.{js,mjs,ts}\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^10.50.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.39",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-error-boundary": "^6.1.6",
    "react-window": "^2.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.63.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "knip": "^6.38.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
