{
  "name": "ddo-tools",
  "private": true,
  "version": "0.0.97",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WestonChan/ddo-tools.git"
  },
  "homepage": "https://ddo-tools.com/",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && stylelint \"src/**/*.css\" && npm run lint:types && npm run lint:dead-code && npm run lint:ignored && npm run format:check",
    "lint:dead-code": "knip --no-progress",
    "lint:ignored": "! { git ls-files --cached --ignored --exclude-standard; git ls-files --others --ignored --exclude-standard -- src e2e eslint-rules; } | grep -v '/\\.DS_Store$' | grep . || (echo 'The files above match a .gitignore pattern; anchor the pattern to the repo root (for example /build/).' && exit 1)",
    "lint:types": "tsc -p tsconfig.test.json --noEmit",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.css\" --fix && npm run format",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"{src,e2e,eslint-rules}/**/*.{ts,tsx,js,css}\" \"*.{js,mjs,ts}\" AGENTS.md",
    "format:check": "prettier --check \"{src,e2e,eslint-rules}/**/*.{ts,tsx,js,css}\" \"*.{js,mjs,ts}\" AGENTS.md",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sentry/react": "^11.8.0",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-window": "^2.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^5.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "knip": "^6.42.0",
    "prettier": "^3.9.10",
    "stylelint": "^17.16.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": "24.x"
  }
}
